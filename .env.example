# Beide Geräte verwenden dieselbe Codebasis, aber je eine eigene .env-Datei.
FLASK_ENV=production
FLASK_DEBUG=0

# Derselbe UNC-Netzwerkordner auf beiden Geräten; keine Laufwerksbuchstaben verwenden.
BACKUP_TARGET=\\firmenserver\freigabe\abw_tool_backups
BACKUP_SOURCE=\\firmenserver\freigabe\abw_tool_backups

# Produktivmodus: sofort beim Start, danach in diesem Intervall.
BACKUP_INTERVAL_MINUTES=1440
BACKUP_KEEP=5
